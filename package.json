{
  "name": "ArcanaWiki",
  "version": "1.0.0",
  "description": "Tarot LLM Wiki with offline BM25 retrieval",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "direnv allow && next dev",
    "build": "next build",
    "start": "next start",
    "index:bm25": "node lib/retrieval/cli/build-bm25-index.ts",
    "index:vector": "node lib/retrieval/cli/build-vector-index.ts",
    "answer": "node lib/answer/cli/answer.ts",
    "search:bm25": "node lib/retrieval/cli/search-bm25.ts",
    "search:vector": "node lib/retrieval/cli/search-vector.ts",
    "search:hybrid": "node lib/retrieval/cli/search-hybrid.ts",
    "inspect:retrieval": "node lib/retrieval/cli/inspect-retrieval.ts",
    "inspect:retrieval:eval": "node lib/retrieval/cli/inspect-retrieval-eval.ts",
    "eval:bm25": "node lib/retrieval/cli/eval-bm25.ts",
    "eval:vector": "node lib/retrieval/cli/eval-vector.ts",
    "eval:hybrid": "node lib/retrieval/cli/eval-hybrid.ts",
    "typecheck": "tsc --noEmit",
    "test:wiki": "node --import tsx --test tests/wiki/*.test.ts",
    "test:retrieval": "node --import tsx --test tests/retrieval/*.test.ts",
    "test:answer": "node --import tsx --test tests/answer/*.test.ts",
    "test:pwa": "node --import tsx --test tests/pwa/*.test.ts tests/pwa/*.test.tsx",
    "test": "node --import tsx --test tests/**/*.test.ts tests/**/*.test.tsx"
  },
  "private": true,
  "dependencies": {
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.1",
    "typescript": "^5.8.3"
  }
}
